# Buildora API — copy to server/.env and adjust

PORT=5000
NODE_ENV=development

# MongoDB (local service installed on Windows uses 27017 by default)
MONGODB_URI=mongodb://127.0.0.1:27017/buildora

# Auth — generate a strong secret:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS / URLs
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# Security throttling
THROTTLE=true

# AI Copilot (optional — leave empty for clearly-labeled demo mode)
# OpenAI-compatible: https://api.openai.com/v1, or any compatible gateway
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=

# Logging
MONGO_DEBUG=false
